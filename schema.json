{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/kucharka/schema.json",
  "title": "Recept",
  "type": "object",
  "required": ["id", "nazev", "kuchyne", "cas_min", "porce", "nakup", "priprava", "postup", "zbytky", "pozor"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "ASCII slug bez diakritiky. Unikátní."
    },
    "nazev": { "type": "string", "minLength": 3 },
    "kuchyne": { "type": "string", "description": "Itálie, Řecko, Španělsko, Levanta …" },
    "vlajka": { "type": "string", "description": "Jeden emoji." },
    "podnadpis": { "type": "string", "maxLength": 120 },
    "datum": {
      "type": "string",
      "pattern": "^$|^\\d{4}-\\d{2}-\\d{2}$",
      "description": "ISO datum plánovaného vaření. Prázdno = zásobník."
    },
    "cas_min": { "type": "integer", "minimum": 5, "maximum": 180 },
    "narocnost": { "type": "string", "enum": ["snadné", "střední", "náročné"] },
    "porce": { "type": "integer", "minimum": 1 },
    "poradi": { "type": "integer", "description": "Timestamp v ms. Řadí seznam sestupně." },
    "vybaveni": { "type": "array", "items": { "type": "string" } },
    "nakup": {
      "type": "array",
      "minItems": 1,
      "description": "Sekce prodejny v pořadí, v jakém se obchodem prochází.",
      "items": {
        "type": "object",
        "required": ["sekce", "polozky"],
        "additionalProperties": false,
        "properties": {
          "sekce": { "type": "string" },
          "polozky": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["co", "kolik"],
              "additionalProperties": false,
              "properties": {
                "co": { "type": "string" },
                "kolik": { "type": "string", "description": "Kusy, lžíce, ml nebo velikost balení. Nikdy gramáž k vážení." },
                "pozn": { "type": "string", "description": "Kde to najít, na co pozor. Může být prázdné." }
              }
            }
          }
        }
      }
    },
    "spiz": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["co", "kolik"],
        "additionalProperties": false,
        "properties": {
          "co": { "type": "string" },
          "kolik": { "type": "string" }
        }
      }
    },
    "priprava": {
      "type": "array",
      "minItems": 3,
      "maxItems": 9,
      "items": { "type": "string" },
      "description": "Vše před zapnutím plotýnky."
    },
    "postup": {
      "type": "array",
      "minItems": 5,
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": ["text", "kontrola"],
        "additionalProperties": false,
        "properties": {
          "cas": { "type": "string", "pattern": "^\\d+:\\d{2}$", "description": "Kumulativní čas od začátku." },
          "text": { "type": "string", "description": "Musí obsahovat konkrétní číslo." },
          "kontrola": { "type": "string", "description": "Viditelný znak hotovosti kroku." }
        }
      }
    },
    "hotovo": { "type": "string" },
    "zbytky": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["co", "kam"],
        "additionalProperties": false,
        "properties": {
          "co": { "type": "string" },
          "kam": { "type": "string", "description": "Kam uložit, jak dlouho vydrží, na co použít." }
        }
      }
    },
    "pozor": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "items": { "type": "string" }
    }
  }
}
